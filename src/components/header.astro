---
import HeaderElement from './header-element.astro'

const base = import.meta.env.BASE_URL;
const elements = [
    { text: 'Blog', path: base },
    { text: 'From PHP to Python', path: 'https://fromphptopython.com', external: true },
    { text: 'About', path: `${base}about/` },
    { text: 'Search', path: `${base}search/`, icon: 'search' },
]

---


<header class="mb-14 md:mb-20">
    <div class="text-right md:my-12 xl:my-16 mb-4 mt-10 text-xl md:text-2xl font-mono">Einenlum<span class="text-pink-700 font-bold">.</span></div>
    <nav class="my-6 md:my-12 md:pr-0 pr-2">
        <ul class="flex justify-end">
            {elements.map((element) => <HeaderElement text={element.text} path={element.path} external={!!element.external} icon={element.icon} />)}
        </ul>
    </nav>
</header>

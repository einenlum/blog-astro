---
interface Props {
    publishedAt: Date,
    title: string
}

const { publishedAt, title } = Astro.props as Props;
const formattedDate = publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<div class="mt-12 mb-10 xl:mb-14 py-6 pb-0 sm:pb-6 pl-0 sm:pl-6 sm:border-l-4 border-pink-900">
    <p class="text-sm tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4" data-pagefind-meta="date">{formattedDate}</p>
    <h1 class="text-2xl md:text-3xl font-sans tracking-wide leading-snug">{title}</h1>
    <div class="mt-8 sm:hidden w-16 mx-auto border-b-2 border-pink-900"></div>
</div>

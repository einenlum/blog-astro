---
import HeaderActiveElement from "./header-active-element.astro";
import HeaderInactiveElement from "./header-inactive-element.astro";

const currentPath = new URL(Astro.request.url).pathname;

interface Props {
    path: string,
    text: string,
    external?: boolean,
    icon?: string
}

const {path, text, icon} = Astro.props as Props;
const isActive = path === currentPath;
const isExternal = Astro.props.external ?? false;

---

{isActive ? <HeaderActiveElement text={text} icon={icon} /> : <HeaderInactiveElement text={text} path={path} external={isExternal} icon={icon} />}

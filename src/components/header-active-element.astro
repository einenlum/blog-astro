---
interface Props {
    text: string,
    icon?: string
}

const { text, icon } = Astro.props as Props
---


<div class="mx-1.5 md:mx-6 last:mr-0 text-base md:text-lg list-none">
    <span class="transition ease-in-out delay-150 text-gray-500 dark:text-gray-400">
        { icon === 'search' ? <>
            <svg xmlns="http://www.w3.org/2000/svg" class="inline w-4 h-4 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="hidden md:inline">{text}</span>
            </> : text
        }
    </span>
</div>

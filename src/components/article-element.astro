---
import ArticleLink from "./article-link.astro";

export interface Article {
    link: string,
    articleTitle: string,
    publishedAt: Date,
    description: string
}

interface Props {
    article: Article
}

const {article} = Astro.props as Props
const formattedDate = article.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="mt-6 mb-6 pb-6 border-b border-gray-200 dark:border-neutral-700 last:border-b-0">
    <ArticleLink href={article.link}>{article.articleTitle}</ArticleLink>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{formattedDate}</p>
    <p class="mt-3 text-gray-700 dark:text-gray-200">{article.description}</p>
</div>
